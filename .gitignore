# =============================================================================
# Git Ignore Configuration — AI Study Planner
# =============================================================================

# --- Secrets & Environment Variables ---
.env
.env.*
!.env.example
**/application-local.properties
**/application-secret.properties

# --- Database & SQL Migrations ---
*.sql
!scripts/*.sql
*.dump
*.bak
.mysql/
**/data/

# --- Backend Generated Files (Maven / Gradle) ---
**/target/
**/build/
.gradle/

# --- Frontend Generated Files ---
**/node_modules/
**/dist/
dist-ssr/
.vite/
coverage/
*.local

# --- Logs & Crash Dumps ---
*.log
hs_err_pid*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Python Generated Files ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
