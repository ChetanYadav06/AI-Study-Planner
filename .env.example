# AI Study Planner Environment Variables
# Copy this file to .env and configure values as needed:
# cp .env.example .env

# Secret key used for signing JWT tokens (minimum 32 bytes / 256 bits).
# If unset, dev.ps1 loads from User environment or generates one automatically.
JWT_SECRET=your-minimum-32-byte-secret-key-here-for-local-dev-change-for-prod

# Optional: Google Gemini API Key for AI roadmap generation (Phase 4+)
# GEMINI_API_KEY=your-gemini-api-key-here

# Optional: MySQL Database Password (defaults to empty if unset)
# DB_PASSWORD=
